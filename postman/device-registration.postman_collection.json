{
	"info": {
		"_postman_id": "eee94098-9f12-4ce3-9c79-d892bfe736da",
		"name": "Sebotics Middleware Device Registration",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "47111323",
		"_collection_link": "https://orbital-module-participant-95520065-4617466.postman.co/workspace/sebotics-springboot~8c9991cf-df1c-4cf8-a1ca-b21b7195735b/collection/47111323-eee94098-9f12-4ce3-9c79-d892bfe736da?action=share&source=collection_link&creator=47111323"
	},
	"item": [
		{
			"name": "Register Device",
			"event": [
				{
					"listen": "test",
					"script": {
                        "exec": [
                            "pm.test(\"Status is 201\", function () {",
                            "    pm.response.to.have.status(201);",
                            "});",
                            "",
                            "const response = pm.response.json();",
                            "pm.environment.set(\"deviceId\", response.data.deviceId);",
                            "",
                            "pm.test(\"Response has device id\", function () {",
                            "    pm.expect(response.data.deviceId).to.exist;",
                            "});",
                            "",
                            "pm.test(\"errcode is 201\", function () {",
                            "    pm.expect(response.errcode).to.eql(201);",
                            "});"
                        ],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"serialNumber\": \"Robot-001\",\n  \"macAddress\": \"AA:BB:CC:11:22:33\",\n  \"elevatorVendor\": \"Sebotics Test\"\n}"
				},
				"url": {
                    "raw": "{{base_url}}/api/v1/device/register",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "device",
                        "register"
                    ]
                },
				"description": "Registers a robot with the middleware. Stores the returned `deviceId` for subsequent requests."
			},
			"response": []
		},
		{
			"name": "Unregister Device",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"if (!pm.environment.get(\"deviceId\")) {",
							"    throw new Error(\"deviceId is not set. Run 'Register Device' first.\");",
							"}"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
                        "exec": [
                            "pm.test(\"Status is 200\", function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "const response = pm.response.json();",
                            "pm.test(\"errcode is 200\", function () {",
                            "    pm.expect(response.errcode).to.eql(200);",
                            "});",
                            "pm.test(\"No data present\", function () {",
                            "    pm.expect(response.data).to.eql(undefined);",
                            "});"
                        ],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "DELETE",
				"header": [],
                "url": {
                    "raw": "{{base_url}}/api/v1/device/unregister/{{deviceId}}",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "device",
                        "unregister",
                        "{{deviceId}}"
                    ]
                },
				"description": "Unregisters the previously created device using the stored `deviceId`."
			},
			"response": []
		},
		{
			"name": "Get Device Info",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
                    "raw": "{{base_url}}/api/v1/device/info?serialNumber=Robot-001",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "device",
                        "info"
                    ],
					"query": [
						{
							"key": "serialNumber",
							"value": "Robot-001"
						}
					]
				},
				"description": "Retrieve device information using a serial number or MAC address."
			},
			"response": []
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"requests": {},
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"requests": {},
				"exec": [
					""
				]
			}
		}
	]
}
