{
  "info": {
    "_postman_id": "c0b79281-4fb9-4b26-87f9-278a3b3b0fb9",
    "name": "Sebotics Middleware Device Registration",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "codex-cli"
  },
  "item": [
    {
      "name": "Register Device",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const response = pm.response.json();",
              "pm.environment.set(\"deviceId\", response.deviceId);",
              "",
              "pm.test(\"Response has device id\", function () {",
              "    pm.expect(response.deviceId).to.exist;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"serialNumber\": \"Robot-CLI-001\",\n  \"macAddress\": \"AA:BB:CC:11:22:33\",\n  \"elevatorVendor\": \"Acme Elevators\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/devices/register",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "devices",
            "register"
          ]
        },
        "description": "Registers a robot with the middleware. Stores the returned `deviceId` for subsequent requests."
      },
      "response": []
    },
    {
      "name": "Unregister Device",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "if (!pm.environment.get(\"deviceId\")) {",
              "    throw new Error(\"deviceId is not set. Run 'Register Device' first.\");",
              "}"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 204\", function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/devices/{{deviceId}}/unregister",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "devices",
            "{{deviceId}}",
            "unregister"
          ]
        },
        "description": "Unregisters the previously created device using the stored `deviceId`."
      },
      "response": []
    }
  ],
  "event": [],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    }
  ]
}
